# The single-host edge: the only published service. Values come from .env
# (written by init.sh). Mirrors the Kubernetes ingress: the data plane on
# api.<domain>, Studio and its /api on studio.<domain>.
# No trusted_proxies: clients reach the edge directly, so it believes no
# forwarded address and sends the real one on.
{
	admin off
}

(tls_mode) {
	tls {$EXCALIBASE_TLS}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

studio.{$EXCALIBASE_DOMAIN} {
	import tls_mode
	import security_headers
	# A handle of its own and first: handle runs before a bare respond, so the
	# allowlist must be one of the handles to cover every route below.
	@outside not remote_ip {$STUDIO_ALLOW_CIDRS}
	handle @outside {
		respond 403
	}
	# A site deploy uploads the whole build (EXC-353): that route alone takes up
	# to 150 MiB (provisioning's ceiling is about 139 MiB) and goes straight to
	# provisioning's edge listener, past Studio's nginx and its body limit.
	@sitesDeploy path_regexp ^/api/projects/[^/]+/sites/[^/]+/deploy$
	handle @sitesDeploy {
		request_body {
			max_size 150MiB
		}
		reverse_proxy provisioning:24006
	}
	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy studio:80
	}
}

api.{$EXCALIBASE_DOMAIN} {
	import tls_mode
	import security_headers
	request_body {
		max_size 10MB
	}
	# Per-project GraphQL (and its realtime WebSocket) and REST.
	@project path_regexp ^/[^/]+/(graphql|api/v1)(/|$)
	handle @project {
		reverse_proxy graphql:10000
	}
	# End-user auth: /auth/{orgSlug}/{projectId}/...
	handle /auth/* {
		reverse_proxy auth:24000
	}
	# Public function invoke and app-user storage: provisioning's edge listener.
	@public path /functions/v1/* /storage/v1/*
	handle @public {
		reverse_proxy provisioning:24006
	}
	handle {
		respond 404
	}
}

# Customer files: signed links into the bundled store's file bucket only.
# The signature covers this host, so it is passed on unchanged.
files.{$EXCALIBASE_DOMAIN} {
	import tls_mode
	import security_headers
	handle /excalibase-storage/* {
		reverse_proxy objectstore:9000
	}
	handle {
		respond 404
	}
}

# The root of the edge's own CA (EXCALIBASE_TLS=internal; absent with Let's Encrypt): a public
# certificate provisioning hands to apps so their server-side calls to api.<domain> verify (EXC-608).
# Port 8081 is not published: only the platform's and the projects' internal networks reach it.
:8081 {
	handle /root.crt {
		# The directory also holds the CA's keys: the server may only ever open this one file.
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		file_server
	}
	handle {
		respond 404
	}
}

# Apps (EXC-575): one file per app, written by provisioning when an app is
# deployed, paused, given a domain or deleted.
import /etc/caddy/apps/*.caddy
