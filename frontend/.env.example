# API Configuration
VITE_API_URL=http://localhost:8080/api

# excalibase-graphql realtime WebSocket endpoint. The studio's TablesPage
# subscribes to this socket to keep the data grid live when the user is
# viewing a table. Defaults to the local docker-compose stack
# (ws://localhost:10000/api/v1/realtime) when unset.
VITE_EXCALIBASE_GRAPHQL_WS_URL=ws://localhost:10000/api/v1/realtime
