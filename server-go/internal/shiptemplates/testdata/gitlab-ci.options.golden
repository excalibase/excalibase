deploy:
  stage: deploy
  image: docker:27
  services:
    - docker:27-dind
  resource_group: excalibase-deploy
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
    IMAGE_REPOSITORY: "acme/web"
  rules:
    - if: $CI_COMMIT_BRANCH == "release/v2"
  script:
    - 'echo "$DOCKERHUB_TOKEN" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin'
    - docker build -t "$IMAGE_REPOSITORY:$CI_COMMIT_SHA" -f apps/poll/Dockerfile.prod apps/poll
    - docker push "$IMAGE_REPOSITORY:$CI_COMMIT_SHA"
    - IMAGE="$(docker inspect --format="{{range .RepoDigests}}{{println .}}{{end}}" "$IMAGE_REPOSITORY:$CI_COMMIT_SHA" | grep "^$IMAGE_REPOSITORY@" | head -n 1)"
    - apk add --no-cache curl
    - |
      curl --fail-with-body -sS -X POST "https://app.example.test/api/projects/proj-a/apps/web/deploy?wait=true" \
        -H "Authorization: Bearer $EXCALIBASE_TOKEN" \
        -H "Content-Type: application/json" \
        -d "{\"image\":\"$IMAGE\",\"commitSha\":\"$CI_COMMIT_SHA\"}"
