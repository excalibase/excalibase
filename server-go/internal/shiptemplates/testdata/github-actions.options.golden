name: Deploy to Excalibase
on:
  push:
    branches: ["release/v2"]
permissions:
  contents: read
concurrency: excalibase-deploy
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
      - id: build
        uses: docker/build-push-action@v6
        with:
          context: "apps/poll"
          file: "apps/poll/Dockerfile.prod"
          push: true
          tags: acme/web:release-v2,acme/web:${{ github.sha }}
      - uses: excalibase/deploy-action@v1
        with:
          app: proj-a/web
          image: acme/web@${{ steps.build.outputs.digest }}
          token: ${{ secrets.EXCALIBASE_TOKEN }}
          api-url: https://app.example.test/api
