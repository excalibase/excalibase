pipeline {
  agent any
  options {
    disableConcurrentBuilds()
  }
  environment {
    IMAGE_REPOSITORY = 'acme/web'
    EXCALIBASE_TOKEN = credentials('excalibase-token')
  }
  stages {
    stage('Build, push and deploy') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_TOKEN')]) {
          sh '''
            echo "$DOCKERHUB_TOKEN" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
            docker build -t "$IMAGE_REPOSITORY:$GIT_COMMIT" .
            docker push "$IMAGE_REPOSITORY:$GIT_COMMIT"
            IMAGE="$(docker inspect --format='{{range .RepoDigests}}{{println .}}{{end}}' "$IMAGE_REPOSITORY:$GIT_COMMIT" | grep "^$IMAGE_REPOSITORY@" | head -n 1)"
            curl --fail-with-body -sS -X POST "https://app.example.test/api/projects/proj-a/apps/web/deploy?wait=true" \\
              -H "Authorization: Bearer $EXCALIBASE_TOKEN" \\
              -H "Content-Type: application/json" \\
              -d "{\\"image\\":\\"$IMAGE\\",\\"commitSha\\":\\"$GIT_COMMIT\\"}"
          '''
        }
      }
    }
  }
}
