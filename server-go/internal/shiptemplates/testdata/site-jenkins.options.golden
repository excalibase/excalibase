pipeline {
  agent any
  options {
    disableConcurrentBuilds()
  }
  environment {
    EXCALIBASE_TOKEN = credentials('excalibase-token')
  }
  stages {
    stage('Build and deploy the site') {
      when { anyOf { branch 'release/v2'; expression { env.GIT_BRANCH == 'origin/release/v2' } } }
      steps {
        sh '''
          cd "apps/web"
          npm ci
          npm run build
          cd "$WORKSPACE"
          tar czf site.tgz -C "apps/web/build" .
          curl --fail-with-body -sS -X POST "https://app.example.test/api/projects/proj-a/sites/0b8f2c1e-5d1a-4c7e-9f2a-3b4c5d6e7f80/deploy?label=$GIT_COMMIT" \\
            -H "Authorization: Bearer $EXCALIBASE_TOKEN" \\
            -H "Content-Type: application/gzip" \\
            --data-binary @site.tgz
        '''
      }
    }
  }
}
