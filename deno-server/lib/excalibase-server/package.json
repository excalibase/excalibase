{
  "name": "@excalibase/server",
  "version": "0.11.0",
  "description": "Server-side types and tagged wrappers for Excalibase Functions, consumed by the Excalibase Deno runtime",
  "keywords": ["excalibase", "functions", "server", "types", "zod"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/excalibase/excalibase-server"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zod-to-json-schema": "^3.22.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsd": "^0.31.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18"
  }
}
