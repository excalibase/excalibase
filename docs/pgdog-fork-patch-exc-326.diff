+fn connect_options() -> async_nats::ConnectOptions {
+    let require_tls = std::env::var("PGDOG_NATS_TLS")
+        .map(|v| v == "true" || v == "1")
+        .unwrap_or(false);
+    let options = async_nats::ConnectOptions::new().require_tls(require_tls);
+
+    if let Ok(creds) = std::env::var("PGDOG_NATS_CREDS_FILE") {
+        match std::fs::read_to_string(&creds) {
+            Ok(contents) => match async_nats::ConnectOptions::with_credentials(&contents) {
+                Ok(with_creds) => return with_creds.require_tls(require_tls),
+                Err(e) => error!("PGDOG_NATS_CREDS_FILE is not a valid NATS creds file: {}", e),
+            },
+            Err(e) => error!("cannot read PGDOG_NATS_CREDS_FILE {}: {}", creds, e),
+        }
+    }
+    if let (Ok(user), Ok(password)) = (
+        std::env::var("PGDOG_NATS_USER"),
+        std::env::var("PGDOG_NATS_PASSWORD"),
+    ) {
+        return options.user_and_password(user, password);
+    }
+    warn!("NATS config watcher is connecting without credentials; set PGDOG_NATS_USER/PGDOG_NATS_PASSWORD or PGDOG_NATS_CREDS_FILE");
+    options
+}
