+/// With Postgres-backed config every (user, database) row is a tenant route
+/// behind one shared address. `auth_type = trust` would let any client that
+/// knows a role name pick any tenant, and passthrough auth would let a client
+/// mint a pool for a database that was never registered, so both are refused.
+fn refuse_unauthenticated_routing() -> Result<(), Box<dyn std::error::Error>> {
+    let general = &config::config().config.general;
+    if matches!(general.auth_type, config::AuthType::Trust) {
+        return Err("auth_type = trust is not allowed with PGDOG_CONFIG_DATABASE_URL".into());
+    }
+    if general.passthrough_auth() {
+        return Err("passthrough_auth is not allowed with PGDOG_CONFIG_DATABASE_URL".into());
+    }
+    Ok(())
+}
